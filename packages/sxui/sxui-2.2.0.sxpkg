-- manifest.lua
-- Package manifest for sxui.
-- Consumed by sxpm to install, upgrade, and remove the SX-UI framework.

return {
    format = "sxpkg-1",

    meta = {
        name        = "sxui",
        version     = "2.2.0",
        author      = "SwirX",
        description = "Modern, object-oriented UI framework for CC:Tweaked with UDim2 layouts, animations, and widgets.",
        channel     = "stable",
    },

    dependencies = {},

    files = {
        -- Core entry point
        { path = "/lib/sxui/ui.lua",                    source = "ui.lua" },

        -- Core internals
        { path = "/lib/sxui/core/class.lua",            source = "core/class.lua" },
        { path = "/lib/sxui/core/animator.lua",         source = "core/animator.lua" },
        { path = "/lib/sxui/core/element.lua",          source = "core/element.lua" },
        { path = "/lib/sxui/core/screen.lua",           source = "core/screen.lua" },

        -- Widgets
        { path = "/lib/sxui/widgets/frame.lua",         source = "widgets/frame.lua" },
        { path = "/lib/sxui/widgets/appwindow.lua",     source = "widgets/appwindow.lua" },
        { path = "/lib/sxui/widgets/button.lua",        source = "widgets/button.lua" },
        { path = "/lib/sxui/widgets/label.lua",         source = "widgets/label.lua" },
        { path = "/lib/sxui/widgets/input.lua",         source = "widgets/input.lua" },
        { path = "/lib/sxui/widgets/checkbox.lua",      source = "widgets/checkbox.lua" },
        { path = "/lib/sxui/widgets/slider.lua",        source = "widgets/slider.lua" },
        { path = "/lib/sxui/widgets/multiline.lua",     source = "widgets/multiline.lua" },
        { path = "/lib/sxui/widgets/textedit.lua",      source = "widgets/textedit.lua" },
        { path = "/lib/sxui/widgets/scrollpanel.lua",   source = "widgets/scrollpanel.lua" },
        { path = "/lib/sxui/widgets/dropdown.lua",      source = "widgets/dropdown.lua" },
        { path = "/lib/sxui/widgets/colorselector.lua", source = "widgets/colorselector.lua" },
    },

    integrity = {
        sha256 = "FILL_ME",
    },
}
