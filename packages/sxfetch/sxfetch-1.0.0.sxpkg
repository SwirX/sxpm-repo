return {
    format = "sxpkg-1",
    meta = {
        name = "sxfetch",
        version = "1.0.0",
        package_type = "application",
        description = "System info fetch tool",
    },
    binaries = { "sxfetch" },
    files = {
        { path = "/usr/bin/sxfetch.lua", source = "bin/sxfetch.lua", executable = true }
    }
}
