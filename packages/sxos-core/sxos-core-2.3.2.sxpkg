local _M = {}

function _M.getUserHome()
    return _ENV.ENV and _ENV.ENV.HOME or "/root"
end

function _M.getAppDirectory(appName)
    local home = _M.getUserHome()
    local path = fs.combine(home, ".config/" .. appName)
