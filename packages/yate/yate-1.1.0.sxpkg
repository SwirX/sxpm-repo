local args = { ... }
if #args < 1 then
    print("Usage: yate <file>")
    return
end

local path = shell.resolve(args[1])
local lines = {}

local w, h = term.getSize()
local cx, cy = 1, 1
local sx, sy = 1, 1
local scrollX, scrollY = 0, 0
local running = true
local mode = "NORMAL" -- NORMAL, INSERT, VISUAL, COMMAND
local cmd_text = ""
local status_msg = ""
local ctrl_held = false
local shift_held = false
local multiplier_text = ""
local pending_p = false

local function load_file(new_path)
    lines = {}
    path = new_path
    if fs.exists(path) then
        local f = fs.open(path, "r")
        if f then
            local content = f.readAll()
            f.close()
            for s in string.gmatch(content .. "\n", "(.-)\n") do
                table.insert(lines, s)
            end
            if #lines > 0 then table.remove(lines, #lines) end
        end
    end
    if #lines == 0 then table.insert(lines, "") end
    cx, cy = 1, 1
    scrollX, scrollY = 0, 0
    mode = "NORMAL"
    multiplier_text = ""
    pending_p = false
end

if fs.exists(path) and fs.isDir(path) then
    printError("yate: Cannot edit directory")
    return
end
load_file(path)

local function set_status(msg)
    status_msg = msg
end

local function get_clip()
    return _G.clipboard or ""
end

local function set_clip(text)
    _G.clipboard = text
    if type(setClipboard) == "function" then
        pcall(setClipboard, text)
    end
end

local function get_selection()
    if mode ~= "VISUAL" then return "" end
    local out = {}
    local min_y, max_y = sy, cy
    local min_x, max_x = sx, cx
    if min_y > max_y then
        min_y, max_y = max_y, min_y
        min_x, max_x = max_x, min_x
    elseif min_y == max_y and min_x > max_x then
        min_x, max_x = max_x, min_x
    end

    for i = min_y, max_y do
        local l = lines[i]
        if i == min_y and i == max_y then
            table.insert(out, string.sub(l, min_x, max_x))
        elseif i == min_y then
            table.insert(out, string.sub(l, min_x))
        elseif i == max_y then
            table.insert(out, string.sub(l, 1, max_x))
        else
            table.insert(out, l)
        end
    end
    return table.concat(out, "\n")
end

local function delete_selection()
    if mode ~= "VISUAL" then return end
    local min_y, max_y = sy, cy
    local min_x, max_x = sx, cx
    if min_y > max_y then
        min_y, max_y = max_y, min_y
        min_x, max_x = max_x, min_x
    elseif min_y == max_y and min_x > max_x then
        min_x, max_x = max_x, min_x
    end

    if min_y == max_y then
        lines[min_y] = string.sub(lines[min_y], 1, min_x - 1) .. string.sub(lines[min_y], max_x + 1)
    else
        local first = string.sub(lines[min_y], 1, min_x - 1)
        local last = string.sub(lines[max_y], max_x + 1)
        lines[min_y] = first .. last
        for i = min_y + 1, max_y do
            table.remove(lines, min_y + 1)
        end
    end
    cx, cy = min_x, min_y
    mode = "NORMAL"
end

local function is_selected(x, y)
    if mode ~= "VISUAL" then return false end
    local min_y, max_y = sy, cy
    local min_x, max_x = sx, cx
    if min_y > max_y then
        min_y, max_y = max_y, min_y
        min_x, max_x = max_x, min_x
    elseif min_y == max_y and min_x > max_x then
        min_x, max_x = max_x, min_x
    end

    if y < min_y or y > max_y then return false end
    if y == min_y and y == max_y then
        return x >= min_x and x <= max_x
    elseif y == min_y then
        return x >= min_x
    elseif y == max_y then
        return x <= max_x
    else
        return true
    end
end

local function get_gw()
    return math.max(3, string.len(tostring(#lines))) + 1
end

local function draw()
    local gw = get_gw()
    term.setBackgroundColor(colors.black)
    for i = 1, h - 1 do
        term.setCursorPos(1, i)
        term.clearLine()
        local lineIdx = scrollY + i
        if lineIdx <= #lines then
            -- Draw gutter
            term.setCursorPos(1, i)
            term.setBackgroundColor(colors.gray)
            if lineIdx == cy then
                term.setTextColor(colors.white)
                local num_str = tostring(lineIdx)
                local pad = gw - string.len(num_str) - 1
                if pad < 0 then pad = 0 end
                term.write(string.rep(" ", pad) .. num_str .. " ")
            else
                term.setTextColor(colors.lightGray)
                local num_str = tostring(math.abs(lineIdx - cy))
                local pad = gw - string.len(num_str) - 1
                if pad < 0 then pad = 0 end
                term.write(string.rep(" ", pad) .. num_str .. " ")
            end

            -- Draw line text
            term.setBackgroundColor(colors.black)
            term.setTextColor(colors.white)
            local l = lines[lineIdx] or ""
            local text_max_width = w - gw

            local start_col = scrollX + 1
            if start_col <= #l + 1 then
                for j = 1, text_max_width do
                    local charIdx = scrollX + j
                    if charIdx <= #l + 1 then
                        local c = string.sub(l, charIdx, charIdx)
                        if c == "" then c = " " end
                        if is_selected(charIdx, lineIdx) then
                            term.setBackgroundColor(colors.gray)
                            term.setTextColor(colors.white)
                        else
                            term.setBackgroundColor(colors.black)
                            term.setTextColor(colors.white)
                        end
                        term.write(c)
                    end
                end
            end
        else
            term.setCursorPos(1, i)
            term.setBackgroundColor(colors.gray)
            term.write(string.rep(" ", gw))
            term.setBackgroundColor(colors.black)
            term.setTextColor(colors.gray)
            term.setCursorPos(gw + 1, i)
            if lineIdx > #lines + 1 then
                term.write("~")
            end
        end
    end

    term.setBackgroundColor(colors.white)
    term.setTextColor(colors.black)
    term.setCursorPos(1, h)
    term.clearLine()

    local left_status = ""
    if mode == "COMMAND" then
        left_status = ":" .. cmd_text
    else
        left_status = "-- " .. mode .. " -- " .. status_msg
        if pending_p then left_status = left_status .. " p" end
        if multiplier_text ~= "" then left_status = left_status .. " [" .. multiplier_text .. "]" end
    end

    local right_status = cy .. "," .. cx .. "  " .. fs.getName(path)

    term.write(left_status)
    local cx_term = term.getCursorPos()
    if w - #right_status > cx_term then
        term.setCursorPos(w - #right_status, h)
        term.write(right_status)
    end

    term.setBackgroundColor(colors.black)
    term.setTextColor(colors.white)
    if mode == "COMMAND" then
        term.setCursorPos(2 + #cmd_text, h)
        term.setCursorBlink(true)
    else
        local term_x = cx - scrollX + gw
        local term_y = cy - scrollY
        if term_x > gw and term_x <= w and term_y >= 1 and term_y <= h - 1 then
            term.setCursorPos(term_x, term_y)
            term.setCursorBlink(true)
        else
            term.setCursorBlink(false)
        end
    end
end

local function save()
    local f = fs.open(path, "w")
    if f then
        for _, l in ipairs(lines) do f.write(l .. "\n") end
        f.close()
        set_status("Saved " .. #lines .. " lines")
        return true
    end
    set_status("Error saving file")
    return false
end

local function insert_str(str)
    for c in string.gmatch(str, ".") do
        if c == "\n" then
            local rest = string.sub(lines[cy], cx)
            lines[cy] = string.sub(lines[cy], 1, cx - 1)
            table.insert(lines, cy + 1, rest)
            cy = cy + 1
            cx = 1
        elseif c ~= "\r" then
            local l = lines[cy]
            lines[cy] = string.sub(l, 1, cx - 1) .. c .. string.sub(l, cx)
            cx = cx + 1
        end
    end
end

local function open_project_view()
    local dir = fs.getDir(path)
    if dir == "" or dir == "." then dir = "" end
    local files = fs.list(dir == "" and "/" or dir)
    local select_idx = 1
    while running do
        term.setBackgroundColor(colors.black)
        term.clear()

        term.setCursorPos(1, 1)
        term.setBackgroundColor(colors.gray)
        term.setTextColor(colors.white)
        term.clearLine()
        term.write(" Project View: " .. (dir == "" and "/" or dir))

        for i, f in ipairs(files) do
            if i + 1 <= h then
                term.setCursorPos(1, i + 1)
                if i == select_idx then
                    term.setBackgroundColor(colors.lightGray)
                    term.setTextColor(colors.black)
                else
                    term.setBackgroundColor(colors.black)
                    term.setTextColor(colors.white)
                end
                term.clearLine()
                term.write(" " .. f .. (fs.isDir(fs.combine(dir, f)) and "/" or ""))
            end
        end

        local event = { os.pullEvent() }
        local ev = event[1]
        if ev == "key" then
            local a = event[2]
            if a == keys.leftCtrl or a == keys.rightCtrl then ctrl_held = true end
            if a == keys.up or a == keys.k then
                select_idx = math.max(1, select_idx - 1)
            elseif a == keys.down or a == keys.j then
                select_idx = math.min(#files, select_idx + 1)
            elseif a == keys.enter then
                if #files == 0 then return false end
                local selected = files[select_idx]
                if selected then
                    local new_path = fs.combine(dir, selected)
                    if fs.isDir(new_path) then
                        dir = new_path
                        files = fs.list(dir == "" and "/" or dir)
                        select_idx = 1
                    else
                        path = new_path
                        return true
                    end
                end
            elseif a == keys.backspace or a == keys.h or a == keys.left then
                local parent = fs.getDir(dir)
                if parent and dir ~= "" then
                    dir = parent
                    files = fs.list(dir == "" and "/" or dir)
                    select_idx = 1
                end
            elseif a == keys.q or a == keys.escape or a == keys.leftAlt or (a == keys.c and ctrl_held) or a == 256 then
                return false
            end
        elseif ev == "key_up" then
            local k = event[2]
            if k == keys.leftCtrl or k == keys.rightCtrl then ctrl_held = false end
        end
    end
    return false
end

while running do
    draw()
    local event = { os.pullEvent() }
    local ev = event[1]

    if ev == "key" then
        local key = event[2]
        if key == keys.leftShift or key == keys.rightShift then shift_held = true end
        if key == keys.leftCtrl or key == keys.rightCtrl then ctrl_held = true end

        if key == keys.leftAlt or key == keys.rightAlt or key == keys.escape or (key == keys.c and ctrl_held) or key == 256 then
            if mode == "VISUAL" and key == keys.c and ctrl_held then
                set_clip(get_selection())
                set_status("Copied")
            else
                set_status("")
            end
            mode = "NORMAL"
            multiplier_text = ""
            pending_p = false
        elseif ctrl_held and key == keys.s then
            save()
        elseif ctrl_held and key == keys.q then
            running = false
        elseif ctrl_held and key == keys.a then
            mode = "VISUAL"
            sx, sy = 1, 1
            cy = #lines
            cx = #lines[cy] + 1
        elseif ctrl_held and key == keys.v and (mode == "INSERT" or mode == "COMMAND") then
            insert_str(get_clip())
        elseif mode == "NORMAL" or mode == "VISUAL" then
            local amount = tonumber(multiplier_text) or 1
            if key == keys.up then
                multiplier_text = ""; pending_p = false
                if shift_held and mode ~= "VISUAL" then
                    mode = "VISUAL"; sx, sy = cx, cy
                end
                if not shift_held and mode == "VISUAL" then mode = "NORMAL" end
                cy = math.max(1, cy - amount)
                if cx > #lines[cy] + 1 then cx = #lines[cy] + 1 end
            elseif key == keys.down then
                multiplier_text = ""; pending_p = false
                if shift_held and mode ~= "VISUAL" then
                    mode = "VISUAL"; sx, sy = cx, cy
                end
                if not shift_held and mode == "VISUAL" then mode = "NORMAL" end
                cy = math.min(#lines, cy + amount)
                if cx > #lines[cy] + 1 then cx = #lines[cy] + 1 end
            elseif key == keys.left then
                multiplier_text = ""; pending_p = false
                if shift_held and mode ~= "VISUAL" then
                    mode = "VISUAL"; sx, sy = cx, cy
                end
                if not shift_held and mode == "VISUAL" then mode = "NORMAL" end
                for _ = 1, amount do
                    if cx > 1 then
                        cx = cx - 1
                    elseif cy > 1 then
                        cy = cy - 1; cx = #lines[cy] + 1
                    end
                end
            elseif key == keys.right then
                multiplier_text = ""; pending_p = false
                if shift_held and mode ~= "VISUAL" then
                    mode = "VISUAL"; sx, sy = cx, cy
                end
                if not shift_held and mode == "VISUAL" then mode = "NORMAL" end
                for _ = 1, amount do
                    if cx <= #lines[cy] then
                        cx = cx + 1
                    elseif cy < #lines then
                        cy = cy + 1; cx = 1
                    end
                end
            elseif mode == "VISUAL" and (key == keys.backspace or key == keys.delete) then
                delete_selection()
            elseif mode == "NORMAL" and key == keys.delete then
                for _ = 1, amount do
                    if cx <= #lines[cy] then
                        lines[cy] = string.sub(lines[cy], 1, cx - 1) .. string.sub(lines[cy], cx + 1)
                    elseif cy < #lines then
                        lines[cy] = lines[cy] .. lines[cy + 1]
                        table.remove(lines, cy + 1)
                    end
                end
                multiplier_text = ""
            end
        else
            if mode == "COMMAND" then
                if key == keys.enter then
                    if cmd_text == "w" or cmd_text == "wq" then save() end
                    if cmd_text == "q" or cmd_text == "wq" or cmd_text == "q!" then running = false end
                    mode = "NORMAL"
                elseif key == keys.backspace then
                    if #cmd_text > 0 then cmd_text = string.sub(cmd_text, 1, -2) else mode = "NORMAL" end
                end
            elseif mode == "INSERT" then
                if key == keys.backspace then
                    if cx > 1 then
                        lines[cy] = string.sub(lines[cy], 1, cx - 2) .. string.sub(lines[cy], cx)
                        cx = cx - 1
                    elseif cy > 1 then
                        local old_len = #lines[cy - 1]
                        lines[cy - 1] = lines[cy - 1] .. lines[cy]
                        table.remove(lines, cy)
                        cy = cy - 1
                        cx = old_len + 1
                    end
                elseif key == keys.delete then
                    if cx <= #lines[cy] then
                        lines[cy] = string.sub(lines[cy], 1, cx - 1) .. string.sub(lines[cy], cx + 1)
                    elseif cy < #lines then
                        lines[cy] = lines[cy] .. lines[cy + 1]
                        table.remove(lines, cy + 1)
                    end
                elseif key == keys.enter then
                    local rest = string.sub(lines[cy], cx)
                    lines[cy] = string.sub(lines[cy], 1, cx - 1)
                    table.insert(lines, cy + 1, rest)
                    cy = cy + 1
                    cx = 1
                end
            end
        end
    elseif ev == "key_up" then
        local key = event[2]
        if key == keys.leftShift or key == keys.rightShift then shift_held = false end
        if key == keys.leftCtrl or key == keys.rightCtrl then ctrl_held = false end
    elseif ev == "char" then
        local c = event[2]
        if mode == "COMMAND" then
            cmd_text = cmd_text .. c
        elseif mode == "INSERT" then
            lines[cy] = string.sub(lines[cy], 1, cx - 1) .. c .. string.sub(lines[cy], cx)
            cx = cx + 1
        elseif mode == "NORMAL" then
            local amount = tonumber(multiplier_text) or 1
            if tonumber(c) then
                if c == "0" and #multiplier_text == 0 then
                    cx = 1
                else
                    multiplier_text = multiplier_text .. c
                end
            elseif pending_p then
                pending_p = false
                if c == "v" then
                    if open_project_view() then
                        load_file(path)
                    end
                else
                    for _ = 1, amount do insert_str(get_clip()) end
                    multiplier_text = ""
                end
            else
                if c == "i" then
                    mode = "INSERT"; set_status(""); multiplier_text = ""
                elseif c == "a" then
                    cx = cx + 1; mode = "INSERT"; set_status(""); multiplier_text = ""
                elseif c == "o" then
                    table.insert(lines, cy + 1, ""); cy = cy + 1; cx = 1; mode = "INSERT"; set_status(""); multiplier_text =
                    ""
                elseif c == "v" then
                    mode = "VISUAL"; sx, sy = cx, cy; set_status(""); multiplier_text = ""
                elseif c == "h" then
                    cx = math.max(1, cx - amount); multiplier_text = ""
                elseif c == "l" then
                    cx = math.min(#lines[cy] + 1, cx + amount); multiplier_text = ""
                elseif c == "k" then
                    cy = math.max(1, cy - amount)
                    if cx > #lines[cy] + 1 then cx = #lines[cy] + 1 end
                    multiplier_text = ""
                elseif c == "j" then
                    cy = math.min(#lines, cy + amount)
                    if cx > #lines[cy] + 1 then cx = #lines[cy] + 1 end
                    multiplier_text = ""
                elseif c == "x" then
                    for _ = 1, amount do
                        if cx <= #lines[cy] then
                            lines[cy] = string.sub(lines[cy], 1, cx - 1) .. string.sub(lines[cy], cx + 1)
                        end
                    end
                    multiplier_text = ""
                elseif c == "p" then
                    pending_p = true
                elseif c == ":" then
                    mode = "COMMAND"
                    cmd_text = ""
                    set_status("")
                    multiplier_text = ""
                else
                    multiplier_text = ""
                end
            end
        elseif mode == "VISUAL" then
            if c == "y" then
                set_clip(get_selection())
                set_status("Yanked")
                mode = "NORMAL"
            elseif c == "d" or c == "x" then
                set_clip(get_selection())
                delete_selection()
            elseif c == "h" then
                if cx > 1 then cx = cx - 1 end
            elseif c == "l" then
                if cx <= #lines[cy] then cx = cx + 1 end
            elseif c == "k" then
                if cy > 1 then
                    cy = cy - 1; if cx > #lines[cy] + 1 then cx = #lines[cy] + 1 end
                end
            elseif c == "j" then
                if cy < #lines then
                    cy = cy + 1; if cx > #lines[cy] + 1 then cx = #lines[cy] + 1 end
                end
            else
                mode = "NORMAL"
            end
        end
    elseif ev == "paste" then
        local text = event[2]
        if mode == "VISUAL" then delete_selection() end
        mode = "INSERT"
        insert_str(text)
    end

    if cx > #lines[cy] + 1 then cx = #lines[cy] + 1 end
    if cx < 1 then cx = 1 end
    if cy < 1 then cy = 1 end

    local gw = get_gw()
    if cy <= scrollY then scrollY = cy - 1 end
    if cy > scrollY + (h - 1) then scrollY = cy - (h - 1) end
    if cx <= scrollX then scrollX = cx - 1 end
    if cx > scrollX + (w - gw) then scrollX = cx - (w - gw) end
end

term.setBackgroundColor(colors.black)
term.setTextColor(colors.white)
term.clear()
term.setCursorPos(1, 1)
manifest.lua
322
return {
    format = "sxpkg-1",
    meta = {
        name = "yate",
        version = "1.1.0",
        package_type = "application",
        description = "Yet Another Text Editor",
    },
    binaries = { "yate" },
    files = {
        { path = "/usr/bin/yate.lua", source = "bin/yate.lua", executable = true }
    }
}
